;;; eval-copy.el --- M-: that also copies its result (and optionally code) -*- lexical-binding: t; -*-

;; Generated by ChatGPT

;;; Commentary:
;;
;; `my/eval-expression-copy'           Like M-:, but also copies the result.
;;                                     With C-u, copies "CODE\nRESULT".
;; `my/eval-expression-copy-with-code' Same as C-u M-x my/eval-expression-copy.
;;
;; Both read input exactly like M-: (same minibuffer, same
;; `read-expression-history'), but keep the raw text you typed/pasted,
;; newlines and comments included.  Several top-level forms are allowed;
;; they are evaluated in order, like a `progn'.
;;
;; If the code signals an error, the copied output is the same backtrace
;; M-: would show in *Backtrace* (see `my/eval-copy-capture-backtrace').

;;; Code:

(require 'subr-x)
(require 'seq)
(require 'cl-lib)
(require 'backtrace)

(defcustom my/eval-copy-capture-output t
  "Non-nil means also copy text emitted during evaluation.
That is anything the code `message's, `print's or `princ's.  It is
placed before the final value in the copied output."
  :type 'boolean
  :group 'lisp)

(defcustom my/eval-copy-catch-errors t
  "Non-nil means report an error as text (and copy it) instead of signaling.
If nil, errors propagate normally (so the debugger/backtrace can
appear) and nothing is copied."
  :type 'boolean
  :group 'lisp)

(defcustom my/eval-copy-capture-backtrace t
  "Non-nil means copy a full backtrace when the code signals an error.
The text is what M-: would show in *Backtrace*: a \"Debugger entered\"
line followed by the stack frames, trimmed to start at your code.
If nil, only the one-line error message is copied.
Has no effect when `my/eval-copy-catch-errors' is nil."
  :type 'boolean
  :group 'lisp)

(defun my/eval-copy--to-clipboard (text)
  "Put TEXT on the kill ring and the system clipboard."
  (kill-new text)
  ;; Terminal Emacs on macOS cannot reach the system clipboard via
  ;; `kill-new', so fall back to pbcopy there.
  (when (and (not (display-graphic-p))
             (eq system-type 'darwin)
             (executable-find "pbcopy"))
    (let ((coding-system-for-write 'utf-8))
      (with-temp-buffer
        (insert text)
        (call-process-region (point-min) (point-max) "pbcopy" nil 0)))))

(defun my/eval-copy--format-frame (frame)
  "Format backtrace FRAME like the *Backtrace* buffer does."
  (let ((fun (backtrace-frame-fun frame))
        (args (backtrace-frame-args frame)))
    (if (backtrace-frame-evald frame)
        (format "  %S(%s)\n" fun (mapconcat #'prin1-to-string args " "))
      (format "  %S\n" (cons fun args)))))

(defun my/eval-copy--backtrace (error-object)
  "Return a *Backtrace*-style string for ERROR-OBJECT.
Must be called from the debugger function.  The stack is trimmed so
that it ends at the `eval' call that ran the user's code."
  (let* ((print-length nil)
         (print-level nil)
         (print-escape-newlines t)
         (print-circle t)
         ;; Frames above this function; the first is the debugger
         ;; function that called us, so drop it.
         (frames (cdr (backtrace-get-frames 'my/eval-copy--backtrace)))
         (above (seq-take-while
                 (lambda (f) (not (eq (backtrace-frame-fun f)
                                      'my/eval-copy--eval)))
                 frames))
         (n (cl-position 'eval above :key #'backtrace-frame-fun
                         :from-end t))
         (shown (if n (seq-take above (1+ n)) above)))
    (string-trim-right
     (concat (format "Debugger entered--Lisp error: %S\n" error-object)
             (mapconcat #'my/eval-copy--format-frame shown "")))))

(defun my/eval-copy--eval (code)
  "Evaluate every form in the string CODE in the current buffer.
Return a list (OUTPUT DISPLAY VALUE) where OUTPUT is the full text to
copy, DISPLAY is the (truncated, like M-:) text to show in the echo
area, and VALUE is the Lisp value (nil on error)."
  (let* ((buf (generate-new-buffer " *eval-copy-output*"))
         (capture my/eval-copy-capture-output)
         (want-trace (and my/eval-copy-catch-errors
                          my/eval-copy-capture-backtrace))
         (trace nil)
         (debugger-fn (lambda (&rest args)
                        (when (eq (car args) 'error)
                          ;; Last capture wins, so an error that was
                          ;; handled inside the code cannot mask the
                          ;; one that actually escaped.
                          (setq trace
                                (ignore-errors
                                  (my/eval-copy--backtrace (cadr args)))))))
         (advice (lambda (orig &optional fmt &rest args)
                   (when (and fmt (buffer-live-p buf))
                     (with-current-buffer buf
                       (goto-char (point-max))
                       (insert (apply #'format-message fmt args) "\n")))
                   (apply orig fmt args)))
         (run (lambda ()
                (eval (car (read-from-string
                            (concat "(progn\n" code "\n)")))
                      lexical-binding)))
         value errtext captured)
    (unwind-protect
        (progn
          (when capture (advice-add 'message :around advice))
          (let ((standard-output (if capture buf standard-output))
                ;; When catching errors, force the debugger machinery on
                ;; so that our debugger function sees every error that
                ;; reaches us, then let the handler below deal with it.
                (debugger (if want-trace debugger-fn debugger))
                (debug-on-error (if my/eval-copy-catch-errors
                                    want-trace
                                  (or debug-on-error
                                      eval-expression-debug-on-error)))
                (debug-ignored-errors (if want-trace nil debug-ignored-errors))
                (inhibit-debugger (if want-trace nil inhibit-debugger)))
            (if my/eval-copy-catch-errors
                (condition-case err
                    (setq value (funcall run))
                  ((debug error)
                   (setq errtext
                         (concat "Error: " (error-message-string err)))))
              (setq value (funcall run)))))
      (advice-remove 'message advice)
      (setq captured (with-current-buffer buf (buffer-string)))
      (kill-buffer buf))
    (let* ((full (cond (errtext (or trace errtext))
                       (t (let ((print-length nil) (print-level nil))
                            (prin1-to-string value)))))
           (shown (or errtext
                      (concat
                       (let ((print-length eval-expression-print-length)
                             (print-level eval-expression-print-level))
                         (prin1-to-string value))
                       (and (fboundp 'eval-expression-print-format)
                            (ignore-errors
                              (eval-expression-print-format value))))))
           (captured (string-trim-right captured))
           (output (if (string-empty-p captured)
                       full
                     (concat captured "\n" full))))
      (list output shown value))))

(defun my/eval-copy--run (with-code)
  "Read code like `eval-expression', evaluate it, copy, and display.
If WITH-CODE is non-nil, the copied text is the code, a newline, then
the output."
  ;; `read--expression' gives us M-:'s exact minibuffer setup (history,
  ;; completion, eldoc, ...).  It returns a parsed form, so recover the
  ;; raw text from the history entry it just pushed.
  (ignore (read--expression "Eval: "))
  (let* ((code (car read-expression-history))
         (res (my/eval-copy--eval code))
         (output (nth 0 res)))
    (my/eval-copy--to-clipboard
     (if with-code
         (concat code (unless (string-suffix-p "\n" code) "\n") output)
       output))
    (message "%s" (nth 1 res))))

;;;###autoload
(defun my/eval-expression-copy (&optional with-code)
  "Like `eval-expression', but also copy the result to the clipboard.
With a prefix argument WITH-CODE, copy the code that was run first,
verbatim, then a newline, then the result."
  (interactive "P")
  (my/eval-copy--run with-code))

;;;###autoload
(defun my/eval-expression-copy-with-code ()
  "Like `my/eval-expression-copy', but always copy the code and the result."
  (interactive)
  (my/eval-copy--run t))

(provide 'eval-copy)
;;; eval-copy.el ends here
